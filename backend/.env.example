# ============================================================================
# CodeLens AI - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================

# Supabase Project URL
# Get from: Supabase Dashboard → Project Settings → API
# Format: https://[project-id].supabase.co

SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (public, safe to expose)
# Get from: Supabase Dashboard → Project Settings → API → anon key
# This is your public/anon key for client-side access
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SECRET! Keep private)
# Get from: Supabase Dashboard → Project Settings → API → service_role key
# Only use on backend, never expose to frontend
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# LLM CONFIGURATION (Groq)
# ============================================================================

# Groq API Key
# Get from: https://console.groq.com/
# Free tier available
# Sign up at: https://groq.com/
GROQ_API_KEY=gsk_your_api_key_here

# Groq Model Selection
# Options: llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768
# Recommended: llama-3.1-8b-instant (fastest and cheapest)
# Default: llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Backend Environment
# Options: development, staging, production
# Default: development

NODE_ENV=development

# Backend Server Configuration
# Host to bind to (0.0.0.0 for public, 127.0.0.1 for local only)
# Default: 0.0.0.0
BACKEND_HOST=0.0.0.0

# Port for backend server
# Default: 8000
BACKEND_PORT=8000

# CORS Origins
# Comma-separated list of allowed origins
# Examples: http://localhost:3000,https://yourdomain.com,vscode-webview://*,chrome-extension://*
# Default: * (allow all)
CORS_ORIGINS=*

# Request timeout (in seconds)
# Default: 30
REQUEST_TIMEOUT=30

# ============================================================================
# EMBEDDING CONFIGURATION
# ============================================================================

# Embedding Model
# Options: all-MiniLM-L6-v2 (recommended), all-mpnet-base-v2, sentence-t5-base
# Default: all-MiniLM-L6-v2
# Note: Changing this requires re-indexing all projects
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding Vector Dimension
# all-MiniLM-L6-v2: 384
# all-mpnet-base-v2: 768
# sentence-t5-base: 768
# Default: 384
EMBEDDING_DIMENSION=384

# Batch Size for Embedding
# How many texts to embed at once (speeds up indexing)
# Default: 10
# Increase for faster indexing (if memory allows), decrease for memory constraints
EMBEDDING_BATCH_SIZE=10

# ============================================================================
# VECTOR SEARCH CONFIGURATION
# ============================================================================

# Default Similarity Threshold (0-1, higher = stricter matching)
# Default: 0.7
SIMILARITY_THRESHOLD=0.7

# Default Number of Chunks to Retrieve
# Default: 5
# Increase for more context, decrease for faster retrieval
DEFAULT_MATCH_COUNT=5

# Maximum Number of Chunks to Retrieve
# Safety limit to prevent excessive retrieval
# Default: 20
MAX_MATCH_COUNT=20

# ============================================================================
# LLM PROMPT CONFIGURATION
# ============================================================================

# LLM Temperature (creativity level)
# 0 = deterministic, 1 = creative
# For explanations: 0.2-0.3 (factual)
# Default: 0.2
LLM_TEMPERATURE=0.2

# LLM Max Tokens (response length)
# Recommended: 2000 for explanations
# Default: 2000
LLM_MAX_TOKENS=2000

# ============================================================================
# DATABASE CONFIGURATION (Advanced)
# ============================================================================

# Database Connection Pool Size
# Default: 10
# Increase for high concurrency
DB_POOL_SIZE=10

# Database Statement Timeout (in milliseconds)
# Default: 30000 (30 seconds)
DB_STATEMENT_TIMEOUT=30000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Log Format
# Options: json, text
# Default: text
LOG_FORMAT=text

# Enable Detailed Logging
# Default: false
DEBUG_MODE=false

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================

# Enable Response Caching
# Default: true
ENABLE_CACHE=true

# Cache TTL (Time To Live) in seconds
# How long to cache LLM responses
# Default: 3600 (1 hour)
CACHE_TTL=3600

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Enable Rate Limiting
# Default: true
ENABLE_RATE_LIMITING=true

# Rate Limit: Requests per minute per IP
# Default: 60
RATE_LIMIT_PER_MINUTE=60

# Rate Limit: Requests per hour per API key
# Default: 1000
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# AUTHENTICATION (Future)
# ============================================================================

# API Key for Backend Authentication
# Generate a secure random string
# Example: openssl rand -hex 32
# API_KEY=your_secret_api_key_here

# JWT Secret (if implementing JWT auth)
# Generate: openssl rand -hex 32
# JWT_SECRET=your_jwt_secret_here

# ============================================================================
# MONITORING & ERROR TRACKING (Optional)
# ============================================================================

# Sentry DSN for error tracking
# Get from: https://sentry.io/
# Leave empty to disable
# SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id

# Enable Performance Monitoring
# Default: false
ENABLE_PERFORMANCE_MONITORING=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Streaming Responses
# Default: false (not yet implemented)
ENABLE_STREAMING=false

# Enable File Watching (auto re-index on changes)
# Default: false
ENABLE_FILE_WATCHER=false

# Enable Analytics
# Default: false
ENABLE_ANALYTICS=false

# ============================================================================
# STORAGE & CLEANUP
# ============================================================================

# Max File Size for Indexing (in bytes)
# Default: 100000 (100 KB)
# Files larger than this will be skipped
MAX_FILE_SIZE=100000

# Auto-cleanup old query history (in days)
# Default: 90
# Set to 0 to disable cleanup
CLEANUP_HISTORY_DAYS=90

# ============================================================================
# VS CODE EXTENSION
# ============================================================================

# Backend URL for VS Code Extension
# Default: http://localhost:8000
# Can be customized per machine
VSCODE_BACKEND_URL=http://localhost:8000

# Auto-index on file save
# Default: false
VSCODE_AUTO_INDEX=false

# ============================================================================
# CHROME EXTENSION
# ============================================================================

# Backend URL for Chrome Extension
# Should be same as VS Code backend
# Default: http://localhost:8000
CHROME_BACKEND_URL=http://localhost:8000

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Seed Database with Sample Data
# Default: false
# Set to true to populate with test data on startup
SEED_DATABASE=false

# Skip Database Validation
# Default: false
# Useful for testing without real database
SKIP_DB_VALIDATION=false

# Mock LLM Responses
# Default: false
# Returns static responses instead of calling Groq
# Useful for testing without API key
MOCK_LLM=false

# ============================================================================
# EXAMPLES & NOTES
# ============================================================================

# GETTING CREDENTIALS:
#
# 1. Supabase URL and Key:
#    a. Create project at https://supabase.com/
#    b. Go to Project Settings → API
#    c. Copy URL and anon key
#
# 2. Groq API Key:
#    a. Sign up at https://console.groq.com/
#    b. Create new API key
#    c. Copy and paste here
#
# QUICK START:
#    1. Copy this file: cp .env.example .env
#    2. Fill in SUPABASE_URL, SUPABASE_KEY, GROQ_API_KEY
#    3. Run backend: uvicorn app.main:app --reload
#    4. Test: curl http://localhost:8000/health
#
# PRODUCTION DEPLOYMENT:
#    1. Set NODE_ENV=production
#    2. Use strong, unique GROQ_API_KEY
#    3. Enable HTTPS
#    4. Set rate limiting appropriately
#    5. Enable monitoring (Sentry)
#    6. Review and adjust LLM settings for cost
#    7. Set up proper logging and backups

# ============================================================================
