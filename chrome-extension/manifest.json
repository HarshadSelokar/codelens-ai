{
  "name": "RAG UI Code Explainer",
  "description": "Explains inspected DOM elements and UI components using AI",
  "version": "0.1.0",
  "manifest_version": 3,

  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background_improved.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_improved.js"]
    }
  ],

  "devtools_page": "devtools.html"
}
